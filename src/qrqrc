# Configuration file for qrq by DJ5CW. Change values as needed. 
# Whitespace around '=' and trailing comments are accepted.
# The settings can be changed and saved from within the
# program, so there is usually no need to manually change anything here.

callsign=MYCALL       # your callsign
initialspeed=100      # initial speed in Letters per Minute / LpM (5 LpM = 1 WpM)
mincharspeed=100      # minimum character speed. below, Farnsworth is used
# supported speed range: 10..5000 CpM (character floor may also be 0)
# legacy shared speed step; retained for compatibility with older qrq configs
speedstep=10
# independent speed change after a correct or incorrect copy (in LpM)
# supported step range: 1..5000 CpM
speedupstep=10
speeddownstep=10
# number of calls per session; 50 is the standard, comparable high-score mode
# (use the F5 configuration screen to change it in steps of five)
sessionlength=50
# limit practice to entries within this character range (1..28)
mincalllength=1
maxcalllength=28
# favor entries copied incorrectly during the current session
# values: 0 = no, 1 = yes (adaptive sessions are not toplist comparable)
adaptiveselection=0
# repeat incorrectly copied calls later in the current session
# values: 0 = no, 1 = yes (review sessions are not toplist comparable)
reviewmisses=0
# restrict a training session to calls or words containing symbols from your
# most common recorded copy differences; 0 = no, 1 = yes (not toplist comparable)
# QRQ uses the normal filtered callbase until character-confusion data exists.
focusconfusions=0
# schedule persistent review from the item-history file. A wrong item is due
# next session; successful items return after 1, 3, 7, 15, then 31 later items.
# values: 0 = no, 1 = yes (spaced-review sessions are not toplist comparable)
spacedrepetition=0
# send a short batch before accepting any entries (1 = normal, 2..5 = copy
# retention drill). Repeats are unavailable while batching is enabled.
# Batch-copy sessions are not toplist comparable.
answerbatch=1
# generate zero-padded contest serial exchanges instead of loading a callbase
# values: 0 = off, 3..5 = number of serial digits (training-only)
serialdigits=0
# minimum whole-session accuracy for a local toplist entry; 0 disables it
# values: 0 or 50..100
accuracytarget=0
# optional callbase filters: comma-separated prefixes, digit/portable mode
# (0 = any, 1 = required, 2 = excluded), and a character whitelist
callprefixes=
digitmode=0
portablemode=0
allowedchars=
# nonzero value makes call and pitch selection repeatable; 0 remains random
sessionseed=0
dspdevice=/dev/dsp    # your DSP device, usually /dev/dsp (for OSS only)
# audio sample rate in Hz (8000..384000)
samplerate=44100

# risetime and falltime for shaping the CW sigs (in milliseconds). recommended
# values: 1..5 see http://fkurz.net/ham/dah.png for an illustration.
# if you have no clue what is is, just leave it ;-) 
risetime=2.000000 

# waveform. Can be 1 = Sine, 2 = Sawtooth, 3 = Square wave
# Default: Sine. Sawtooth and square wave contain more overtones and may be
# better to hear at very high speeds.
waveform=1    

# constanttone 
# don't change the cw tone pitch
# values: 0,1  (0 = not constant , 1 = constant)
constanttone=0    

# ctonefreq
# frequency of the constant tone
# values: 100 - 1600
ctonefreq=600     

# output volume as a percentage (0..100)
volume=100

# random sidetone range when constanttone=0
minpitch=500
maxpitch=900

# QRN-like background noise as a percentage (0..100)
qrnlevel=0

# co-channel CW interference as a percentage (0 = no QRM)
qrmlevel=0

# QSB-like slow signal fading depth as a percentage (0 = steady signal)
qsblevel=0

# allow unlimited usage of F6
# values: 0 = no, 1 = yes
f6=0   

# use fixed speed in the attempts, regardless of errors
# values: 0 = no, 1 = yes
fixspeed=0 

# allow unlimited attempts (instead of just 50 calls)
# values: 0 = no, 1 = yes
unlimitedattempt=0   

# pause/stop after a call was copied wrong (must press enter again to resume)
# values: 0 = no, 1 = yes
stoponerror=0

# Callbase - specify a different file here, if desired.
# callbase=/tmp/test
# callbase=callbase.qcb 
