#!/usr/bin/perl

# qrqscore - synchronize QRQ's local and public score lists.

use strict;
use warnings;
use Fcntl qw(:flock);
use File::Basename qw(dirname);
use File::Copy qw(copy);
use File::Temp qw(tempfile);
use LWP::UserAgent;

my @urls = (
	'https://fkurz.net/ham/qrqtop.php',
	'https://dj1yfk.de/ham/qrqtop.php',
);
my $download_only = 0;
my ($qrqrc, $toplist);
my $mycall;

sub usage {
	print "Usage: qrqscore -u | -d\n";
	print "  -u  Download and merge the toplist, then upload your best score.\n";
	print "  -d  Download and merge the toplist without uploading.\n";
}

sub fatal {
	my ($message) = @_;
	print STDERR "qrqscore: $message\n";
	exit 1;
}

sub parse_record {
	my ($line) = @_;
	my ($call_field, $score_field, $speed_field, $timestamp_field);
	my $call;

	$line =~ s/\r?\n\z//;
	return if length($line) != 31;
	($call_field, $score_field, $speed_field, $timestamp_field) =
		$line =~ /\A(.{10})( {0,5}\d{1,6}) (\d{3}) (\d{10})\z/;
	return unless defined $timestamp_field;
	$call = $call_field;
	$call =~ s/ +\z//;
	return unless length($call) != 0 && $call =~ /\A[A-Za-z0-9\/]+\z/;
	return {
		call => uc($call),
		score => 0 + $score_field,
		raw => sprintf("%-10.10s%6d %3d %10s", uc($call), $score_field,
			$speed_field, $timestamp_field),
	};
}

sub read_records {
	my ($path) = @_;
	open my $file, '<', $path or fatal("cannot read $path: $!");
	my @records;
	while (my $line = <$file>) {
		my $record = parse_record($line);
		fatal("invalid toplist record in $path") unless defined $record;
		push @records, $record;
	}
	close $file or fatal("cannot close $path: $!");
	return @records;
}

sub read_callsign {
	my ($path) = @_;
	open my $file, '<', $path or fatal("cannot read $path: $!");
	while (my $line = <$file>) {
		if ($line =~ /^\s*callsign\s*=\s*([A-Za-z0-9\/]+)(?:\s|#|\z)/) {
			close $file or fatal("cannot close $path: $!");
			return uc($1);
		}
	}
	close $file or fatal("cannot close $path: $!");
	fatal("no valid callsign found in $path");
}

sub download_records {
	my $ua = LWP::UserAgent->new(timeout => 15);
	$ua->agent('qrq-score/0.3.6');
	for my $url (@urls) {
		my $response = $ua->post($url, [mode => 'plain']);
		next unless $response->is_success;
		my @records;
		my $valid = 1;
		for my $line (split /\n/, $response->decoded_content) {
			my $record = parse_record($line);
			if (!defined $record) {
				$valid = 0;
				last;
			}
			push @records, $record;
		}
		return ($url, @records) if $valid && @records;
	}
	fatal('could not download a valid toplist from any configured server');
}

sub merged_records {
	my (@records) = @_;
	my (%best, %own_seen);
	my @own;

	for my $record (@records) {
		if ($record->{call} eq $mycall) {
			next if $own_seen{$record->{raw}}++;
			push @own, $record;
			next;
		}
		if (!exists $best{$record->{call}} ||
				$record->{score} > $best{$record->{call}}->{score}) {
			$best{$record->{call}} = $record;
		}
	}
	return sort {
		$b->{score} <=> $a->{score} || $a->{raw} cmp $b->{raw}
	} (@own, values %best);
}

sub write_records_atomic {
	my ($path, @records) = @_;
	my ($file, $temporary) = tempfile('.qrqscore.XXXXXX', DIR => dirname($path),
		UNLINK => 0);
	for my $record (@records) {
		print {$file} $record->{raw}, "\n" or fatal("cannot write $temporary: $!");
	}
	close $file or fatal("cannot close $temporary: $!");
	rename $temporary, $path or fatal("cannot replace $path: $!");
}

if (@ARGV != 1 || ($ARGV[0] ne '-u' && $ARGV[0] ne '-d')) {
	usage();
	exit(@ARGV == 0 ? 0 : 1);
}
$download_only = $ARGV[0] eq '-d';

if (-e 'qrqrc' && -e 'toplist') {
	$qrqrc = 'qrqrc';
	$toplist = 'toplist';
} elsif (defined $ENV{HOME} && -e "$ENV{HOME}/.qrq/qrqrc" &&
		-e "$ENV{HOME}/.qrq/toplist") {
	$qrqrc = "$ENV{HOME}/.qrq/qrqrc";
	$toplist = "$ENV{HOME}/.qrq/toplist";
} else {
	fatal("cannot find qrqrc and toplist in the current directory or ~/.qrq");
}

$mycall = read_callsign($qrqrc);
open my $lock, '>>', "$toplist.lock" or fatal("cannot open toplist lock: $!");
flock($lock, LOCK_EX) or fatal("cannot lock toplist: $!");
my @local = read_records($toplist);
my ($server, @public) = download_records();
my @merged = merged_records(@local, @public);
my $backup = "$toplist-old";
if (-e $backup) {
	$backup .= '-' . time . '-' . $$;
}
copy($toplist, $backup) or fatal("cannot back up $toplist to $backup: $!");
write_records_atomic($toplist, @merged);
print "Downloaded and merged toplist from $server. Backup: $backup\n";

if (!$download_only) {
	my ($record) = grep { $_->{call} eq $mycall } @merged;
	if (defined $record) {
		my $ua = LWP::UserAgent->new(timeout => 15);
		$ua->agent('qrq-score/0.3.6');
		my $response = $ua->post($server, [mode => 'update', line => $record->{raw}]);
		fatal('failed to upload score: ' . $response->status_line)
			unless $response->is_success;
		print "Uploaded score for $mycall.\n";
	} else {
		print "No score for $mycall to upload.\n";
	}
}
